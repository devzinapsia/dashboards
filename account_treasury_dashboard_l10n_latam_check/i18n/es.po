#. module: account_treasury_dashboard_l10n_latam_check
#. odoo-python
#: code:addons/account_treasury_dashboard_l10n_latam_check/models/account_treasury_config.py:0
msgid ""
"Journal %(journal)s is a check journal, so it can't be payment mean "
"%(medium)s: its checks are shown in the Checks section. Remove the payment "
"mean first."
msgstr ""
"El diario %(journal)s es un diario de cheques, por lo que no puede ser el "
"medio de pago %(medium)s: sus cheques se muestran en la sección Cheques. "
"Quite primero el medio de pago."

#. module: account_treasury_dashboard_l10n_latam_check
#. odoo-python
#: code:addons/account_treasury_dashboard_l10n_latam_check/models/account_treasury_medium.py:0
msgid ""
"Journal %(journal)s is configured as a check journal, so it can't be payment"
" mean %(medium)s: its checks are shown in the Checks section."
msgstr ""
"El diario %(journal)s está configurado como diario de cheques, por lo que no"
" puede ser el medio de pago %(medium)s: sus cheques se muestran en la "
"sección Cheques."

#. module: account_treasury_dashboard_l10n_latam_check
#. odoo-python
#: code:addons/account_treasury_dashboard_l10n_latam_check/models/account_treasury_config.py:0
msgid ""
"Journal %s can't be both a third-party check journal and a rejected check "
"journal."
msgstr ""
"El diario %s no puede ser a la vez diario de cheques de terceros y de "
"cheques rechazados."

#. module: account_treasury_dashboard_l10n_latam_check
#: model:ir.model.fields,help:account_treasury_dashboard_l10n_latam_check.field_account_treasury_config__third_party_check_journal_ids
msgid ""
"Journals holding the third-party checks in portfolio. Their checks are shown"
" in the Checks section and projected on their payment date; these journals "
"can't be a bank or cash payment mean."
msgstr ""
"Diarios donde están los cheques de terceros en cartera. Sus cheques se "
"muestran en la sección Cheques y se proyectan en su fecha de cobro; estos "
"diarios no pueden ser un medio de pago de banco o efectivo."

