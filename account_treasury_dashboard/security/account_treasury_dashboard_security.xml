<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Following dashboards_base's documented pattern: one res.groups.privilege
        per feature, category_id pointing to the shared "Dashboards" category,
        and res.groups records chained with implied_ids (lowest level first).
    -->
    <record model="res.groups.privilege" id="res_groups_privilege_treasury">
        <field name="name">Treasury</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="dashboards_base.module_category_dashboards"/>
    </record>

    <record id="group_treasury_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_treasury"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_treasury_dashboard_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_dashboard_user'))]"/>
    </record>

    <!-- Multi-company: the configuration (and its lines) is only visible from its own company. -->
    <record id="account_treasury_config_comp_rule" model="ir.rule">
        <field name="name">Treasury dashboard configuration: multi-company</field>
        <field name="model_id" ref="model_account_treasury_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="account_treasury_medium_comp_rule" model="ir.rule">
        <field name="name">Treasury dashboard payment mean: multi-company</field>
        <field name="model_id" ref="model_account_treasury_medium"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="account_treasury_commitment_comp_rule" model="ir.rule">
        <field name="name">Treasury dashboard projection commitment: multi-company</field>
        <field name="model_id" ref="model_account_treasury_commitment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
