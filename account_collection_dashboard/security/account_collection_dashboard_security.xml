<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Following dashboards_base's documented pattern: one res.groups.privilege
        per feature, category_id pointing to the shared "Dashboards" category,
        and res.groups records chained with implied_ids (lowest level first).
    -->
    <record model="res.groups.privilege" id="res_groups_privilege_collection">
        <field name="name">Collection</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="dashboards_base.module_category_dashboards"/>
    </record>

    <record id="group_collection_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_collection"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_collection_dashboard_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_collection"/>
        <field name="implied_ids" eval="[(4, ref('group_collection_dashboard_user'))]"/>
    </record>

</odoo>
