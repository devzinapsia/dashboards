<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="account_collection_dashboard.CollectionDashboard">
        <Layout display="display">
            <div class="o_account_collection_dashboard p-3">

                <div class="d-flex justify-content-end gap-2 mb-3">
                    <select class="form-select w-auto" t-on-change="onTurnoverPeriodChange">
                        <option value="current_fiscal_year" t-esc="labels.currentFiscalYear" t-att-selected="state.turnoverPeriod === 'current_fiscal_year'"/>
                        <option value="previous_fiscal_year" t-esc="labels.previousFiscalYear" t-att-selected="state.turnoverPeriod === 'previous_fiscal_year'"/>
                        <option value="last_12_months" t-esc="labels.last12Months" t-att-selected="state.turnoverPeriod === 'last_12_months'"/>
                    </select>
                    <select class="form-select w-auto" t-on-change="onCurrencyChange">
                        <option value="" t-esc="labels.allCurrencies"/>
                        <t t-foreach="state.currencies" t-as="currency" t-key="currency.id">
                            <option
                                t-att-value="currency.id"
                                t-att-selected="state.selectedCurrencyId === currency.id"
                                t-esc="currency.name"
                            />
                        </t>
                    </select>
                </div>

                <div class="row g-3 mb-4">
                    <div t-if="state.totalReceivable" class="col-12 col-md-3">
                        <DashboardsKpiCard
                            title="labels.totalReceivable"
                            value="formatMonetary(state.totalReceivable.amount, state.totalReceivable.currency_id)"
                            onClick="() => this.onDrilldownClick(state.totalReceivable.drilldown)"
                        />
                    </div>
                    <div t-if="state.rejectedChecks" class="col-12 col-md-3">
                        <DashboardsKpiCard
                            title="labels.rejectedChecks"
                            value="formatMonetary(state.rejectedChecks.amount, state.rejectedChecks.currency_id)"
                            secondaryValue="state.rejectedChecks.count"
                            onClick="() => this.onDrilldownClick(state.rejectedChecks.drilldown)"
                        />
                    </div>
                    <div t-if="state.collectionTurnover" class="col-12 col-md-3">
                        <DashboardsKpiCard
                            title="labels.collectionTurnover"
                            value="state.collectionTurnover.turnover.toFixed(1)"
                        />
                    </div>
                    <div t-if="state.collectionPaymentRatio" class="col-12 col-md-3">
                        <DashboardsKpiCard
                            title="labels.collectionPaymentRatio"
                            value="state.collectionPaymentRatio.ratio.toFixed(2)"
                        />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div t-if="state.customersWithDebt" class="col-12 col-md-3">
                        <DashboardsKpiCard
                            title="labels.customersWithDebt"
                            value="state.customersWithDebt.count"
                            onClick="() => this.onDrilldownClick(state.customersWithDebt.drilldown)"
                        />
                    </div>
                    <div t-if="state.undueDebt" class="col-12 col-md-3">
                        <DashboardsKpiCard
                            title="labels.undueDebt"
                            value="formatMonetary(state.undueDebt.amount, state.undueDebt.currency_id)"
                            onClick="() => this.onDrilldownClick(state.undueDebt.drilldown)"
                        />
                    </div>
                    <div t-if="state.dueToday" class="col-12 col-md-3">
                        <DashboardsKpiCard
                            title="labels.dueToday"
                            value="formatMonetary(state.dueToday.amount, state.dueToday.currency_id)"
                            onClick="() => this.onDrilldownClick(state.dueToday.drilldown)"
                        />
                    </div>
                    <div t-if="state.dueNext7Days" class="col-12 col-md-3">
                        <DashboardsKpiCard
                            title="labels.dueNext7Days"
                            value="formatMonetary(state.dueNext7Days.amount, state.dueNext7Days.currency_id)"
                            onClick="() => this.onDrilldownClick(state.dueNext7Days.drilldown)"
                        />
                    </div>
                </div>

                <div class="mb-1 text-muted small" t-if="state.dueSoonByLevel.length" t-esc="labels.dueSoonByLevel"/>
                <div class="row g-3 mb-3">
                    <t t-foreach="state.dueSoonByLevel" t-as="level" t-key="level.level_id">
                        <div class="col-12 col-md-4">
                            <DashboardsKpiCard
                                title="level.level_name"
                                value="formatMonetary(level.amount, level.currency_id)"
                                onClick="() => this.onDrilldownClick(level.drilldown)"
                            />
                        </div>
                    </t>
                </div>

                <div class="mb-1 text-muted small" t-esc="labels.overdueByAge"/>
                <div class="row g-3 mb-3">
                    <t t-foreach="state.overdueByAge" t-as="bucket" t-key="bucket.label">
                        <div class="col-12 col-md-3">
                            <DashboardsKpiCard
                                title="bucket.label"
                                value="formatMonetary(bucket.amount, bucket.currency_id)"
                                onClick="() => this.onDrilldownClick(bucket.drilldown)"
                            />
                        </div>
                    </t>
                </div>

                <div class="mb-1 text-muted small" t-if="state.topOverduePartners.length" t-esc="labels.topOverduePartners"/>
                <div class="row g-3 mb-4">
                    <t t-foreach="state.topOverduePartners" t-as="partnerRow" t-key="partnerRow.partner_id">
                        <div class="col-12 col-md-4">
                            <DashboardsKpiCard
                                title="partnerRow.partner_name"
                                value="formatMonetary(partnerRow.amount, partnerRow.currency_id)"
                                onClick="() => this.onDrilldownClick(partnerRow.drilldown)"
                            />
                        </div>
                    </t>
                </div>

                <h5 class="mb-3" t-esc="labels.treasurySection"/>
                <div class="row g-3 mb-4">
                    <div t-if="state.fixedFund" class="col-12 col-md-4">
                        <DashboardsKpiCard
                            title="labels.fixedFund"
                            value="formatMonetary(state.fixedFund.balance, state.fixedFund.currency_id)"
                            onClick="() => this.onDrilldownClick(state.fixedFund.drilldown)"
                        />
                    </div>
                    <t t-foreach="state.bankBalances" t-as="bank" t-key="bank.journal_id">
                        <div class="col-12 col-md-4">
                            <DashboardsKpiCard
                                title="bank.journal_name"
                                value="formatMonetary(bank.balance, bank.currency_id)"
                                onClick="() => this.onDrilldownClick(bank.drilldown)"
                            />
                        </div>
                    </t>
                    <div t-if="state.cashCollections" class="col-12 col-md-4">
                        <DashboardsKpiCard
                            title="labels.cashCollections"
                            value="formatMonetary(state.cashCollections.amount, state.cashCollections.currency_id)"
                            secondaryValue="state.cashCollections.count"
                            onClick="() => this.onDrilldownClick(state.cashCollections.drilldown)"
                        />
                    </div>
                    <t t-if="state.checksInPortfolio">
                        <t t-foreach="state.checksInPortfolio.by_currency" t-as="checkRow" t-key="checkRow.currency_id">
                            <div class="col-12 col-md-4">
                                <DashboardsKpiCard
                                    title="labels.checksInPortfolio"
                                    value="formatMonetary(checkRow.amount, checkRow.currency_id)"
                                    secondaryValue="checkRow.count"
                                    onClick="() => this.onDrilldownClick(state.checksInPortfolio.drilldown)"
                                />
                            </div>
                        </t>
                    </t>
                </div>

                <h5 class="mb-3" t-esc="labels.reconciliationSection"/>
                <div class="row g-3 mb-4" t-if="state.pendingReconciliation">
                    <div class="col-12 col-md-4">
                        <DashboardsKpiCard
                            title="labels.pendingReconciliation"
                            value="formatMonetary(state.pendingReconciliation.amount, state.pendingReconciliation.currency_id)"
                            secondaryValue="state.pendingReconciliation.count"
                            onClick="() => this.onDrilldownClick(state.pendingReconciliation.drilldown)"
                        />
                    </div>
                </div>

                <h5 class="mb-3" t-esc="labels.multiCurrencySection"/>
                <div class="row g-3 mb-4" t-if="state.pendingExchangeDifference">
                    <div class="col-12 col-md-4">
                        <DashboardsKpiCard
                            title="labels.pendingExchangeDifference"
                            value="formatMonetary(state.pendingExchangeDifference.amount, state.pendingExchangeDifference.currency_id)"
                            secondaryValue="state.pendingExchangeDifference.count"
                            onClick="() => this.onDrilldownClick(state.pendingExchangeDifference.drilldown)"
                        />
                    </div>
                </div>

                <h5 class="mb-3" t-esc="labels.bySalespersonSection"/>
                <div class="row g-3 mb-4">
                    <t t-foreach="state.collectionByUser" t-as="userRow" t-key="userRow.user_id">
                        <div class="col-12 col-md-4">
                            <DashboardsKpiCard
                                title="userRow.user_name"
                                value="formatMonetary(userRow.amount, state.totalReceivable and state.totalReceivable.currency_id)"
                                onClick="() => this.onDrilldownClick(userRow.drilldown)"
                            />
                        </div>
                    </t>
                </div>

            </div>
        </Layout>
    </t>

</templates>
