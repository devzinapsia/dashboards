<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_pl_structure_form" model="ir.ui.view">
        <field name="name">account.pl.structure.form</field>
        <field name="model">account.pl.structure</field>
        <field name="arch" type="xml">
            <form string="Management P&amp;L structure">
                <sheet>
                    <!-- "active" is left out on purpose: without it the form has no
                         Archive action, so (with create/delete disabled by
                         action_open_config) no gear menu at all. -->
                    <field name="company_currency_id" invisible="1"/>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="excluded_journal_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Currency">
                            <field name="secondary_currency_id" options="{'no_create': True}"/>
                            <field name="default_display_currency" widget="radio"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <div class="alert alert-info" role="status" invisible="id">
                                Save the structure to create its sections (Sales, Direct costs, Indirect costs) and start adding lines below them.
                            </div>
                            <!-- pl_structure_lines: "Add a line" adds a sibling of the
                                 edited row, never a section (see its JS). -->
                            <field name="line_ids" invisible="not id" widget="pl_structure_lines"
                                   context="{'default_structure_id': id}">
                                <list editable="bottom" decoration-bf="is_root or is_group"
                                      default_order="sort_key, id" open_form_view="True" limit="1000">
                                    <field name="sequence" widget="handle"/>
                                    <field name="structure_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="is_root" column_invisible="1"/>
                                    <field name="is_group" column_invisible="1"/>
                                    <field name="level" column_invisible="1"/>
                                    <field name="sort_key" column_invisible="1"/>
                                    <field name="section" column_invisible="1"/>
                                    <field name="name" widget="pl_indented_char"/>
                                    <field name="parent_id" readonly="is_root" required="not is_root"
                                           optional="hide" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="account_ids" widget="many2many_tags"
                                           invisible="is_root or is_group"
                                           options="{'no_create': True}"/>
                                    <field name="assignment_status" string="Status" widget="badge"
                                           decoration-warning="assignment_status"/>
                                    <button name="action_add_child" type="object" icon="fa-plus"
                                            title="Add sub-line" string="Sub-line"
                                            invisible="account_ids"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Opened by the "View" link of the structure's lines list. -->
    <record id="view_account_pl_structure_line_form" model="ir.ui.view">
        <field name="name">account.pl.structure.line.form</field>
        <field name="model">account.pl.structure.line</field>
        <field name="arch" type="xml">
            <form string="Management P&amp;L structure line">
                <sheet>
                    <field name="structure_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="is_root" invisible="1"/>
                    <field name="is_group" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" readonly="is_root" required="not is_root"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="section"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="assignment_status" widget="badge" decoration-warning="assignment_status"
                                   invisible="not assignment_status"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not is_root and not is_group">
                        This line is a section or group: its amount is the sum of its sub-lines, so it has no accounts of its own.
                    </div>
                    <notebook invisible="is_root or is_group">
                        <page string="Accounts" name="accounts">
                            <field name="account_ids" options="{'no_create': True}">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="account_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Configuration menu: opens the current company's structure directly. -->
    <record id="action_account_pl_structure_config" model="ir.actions.server">
        <field name="name">Configure management P&amp;L structure</field>
        <field name="model_id" ref="model_account_pl_structure"/>
        <field name="group_ids" eval="[(4, ref('group_management_pl_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_config()</field>
    </record>

</odoo>
