<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Shared security category for every dashboard concept module.

        Concept modules (e.g. account_collection_dashboard) must NOT set
        category_id directly on their res.groups records: in Odoo 19,
        res.groups no longer carries category_id. Instead, each concept
        module should create one res.groups.privilege per feature, with
        category_id = this category, and then create its res.groups
        records with privilege_id pointing to that privilege (chaining
        access levels with implied_ids), the same way core modules like
        fleet do it in security/fleet_security.xml. This is what makes
        the groups show up neatly grouped under "Dashboards" in
        Settings > Users & Companies > Permissions.
    -->
    <record model="ir.module.category" id="module_category_dashboards">
        <field name="name">Dashboards</field>
        <field name="sequence">30</field>
    </record>

</odoo>
